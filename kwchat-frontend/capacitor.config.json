{
  "appId": "com.kwp.chat",
  "appName": "快伟通",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "hostname": "localhost"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#2b7fff",
      "showSpinner": true,
      "spinnerColor": "#ffffff"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#2b7fff",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "none",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#2b7fff"
    }
  }
}
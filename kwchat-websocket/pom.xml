        <dependency>
            <groupId>com.kwp.chat</groupId>
            <artifactId>kwchat-service</artifactId>
        </dependency>

        <!-- KWChat Common -->
        <dependency>
            <groupId>com.kwp.chat</groupId>
            <artifactId>kwchat-common</artifactId>
        </dependency>

        <!-- Netty -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>